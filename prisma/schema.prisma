generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      String   @default("student")
  createdAt DateTime @default(now())
}

model Lesson {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  content     String
  image       String?
}